# Infinity Hub Admin Configuration Template
# Copy this file to .env and adjust values as needed

# Local server port
PORT=3000

# Admin password for sending, updating, and deleting announcements
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Public base URL (used for client connection endpoints and links)
# For local development: http://localhost:3000
# For public production: https://admin.infinityhub.com (or your domain/ngrok URL)
PUBLIC_BASE_URL=http://localhost:3000
